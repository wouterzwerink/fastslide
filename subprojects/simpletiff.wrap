# simpletiff (NKI-AI/simpletiff, synced from the monorepo). Provides the
# `simpletiff` dependency. Revision matches the git_override in MODULE.bazel. In
# the monorepo this is overridden by a local symlink
# subprojects/simpletiff -> ../../simpletiff.
[wrap-git]
url = https://github.com/wouterzwerink/simpletiff.git
revision = b60063226072b3420ffa59fc8ed545e5b03e28f0

[provide]
dependency_names = simpletiff
